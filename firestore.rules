rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isAssignedToProject(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return isSignedIn() && request.auth.uid in project.data.assignedEngineerIds;
    }

    // Users can read any profile (needed for the engineer directory and
    // assignment pickers), but may only create/update their own document.
    // The role is set once at registration and cannot be self-escalated.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.assignedEngineerIds);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();

      match /tasks/{taskId} {
        allow read: if isAdmin() || isAssignedToProject(projectId);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.assignedToId == request.auth.uid);
      }
    }

    // Inspection reports are append-only field records tied to a project.
    match /inspections/{inspectionId} {
      allow read: if isAdmin() || isAssignedToProject(resource.data.projectId);
      allow create: if isSignedIn()
                    && request.resource.data.inspectorId == request.auth.uid
                    && isAssignedToProject(request.resource.data.projectId);
      allow update, delete: if isAdmin();
    }

    // Cost estimates: any team member on the project can build one, only
    // admins can remove one.
    match /estimates/{estimateId} {
      allow read: if isAdmin() || isAssignedToProject(resource.data.projectId);
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && (isAdmin() || isAssignedToProject(request.resource.data.projectId));
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
