rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAssignedToProject(projectId) {
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId));
      return isSignedIn() && request.auth.uid in project.data.assignedEngineerIds;
    }

    match /inspection_photos/{projectId}/{fileName} {
      allow read: if isAdmin() || isAssignedToProject(projectId);
      allow write: if (isAdmin() || isAssignedToProject(projectId))
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
