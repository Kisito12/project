rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isCompanyMemberOf(companyId) {
      return isSignedIn() && userDoc().data.companyId == companyId;
    }

    function isCompanyAdminOf(companyId) {
      return isSignedIn() && userDoc().data.role == 'companyAdmin' && userDoc().data.companyId == companyId;
    }

    function projectCompanyId(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.companyId;
    }

    // Architect's plan drawings, one folder per company/project.
    match /plans/{companyId}/{projectId}/{fileName} {
      allow read: if isCompanyMemberOf(companyId);
      allow write: if isCompanyAdminOf(companyId)
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Site inspection photos, one folder per project.
    match /inspection_photos/{projectId}/{fileName} {
      allow read: if isCompanyMemberOf(projectCompanyId(projectId));
      allow write: if isCompanyMemberOf(projectCompanyId(projectId))
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
